<?xml version="1.0" encoding="UTF-8"?>
<!--
  Phase 5 integration tests — REAL infrastructure.
  Run with: php artisan test --configuration=phpunit.integration.xml
  
  Requires:
    - MySQL running (DB_DATABASE=boss888_test)
    - Redis running
    - Queue workers NOT needed (tests dispatch but don't wait for workers)
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true">
    <testsuites>
        <testsuite name="Integration">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <php>
    <!--
        force="true" added 2026-07-31 during the INC-2026-006 safety sweep.

        Every <env> here previously lacked it. PHPUnit does not override an
        environment variable that is already set unless force is present, so a
        run launched from a process that already exports DB_DATABASE — which is
        every nested invocation on this platform — ignored the value below and
        resolved to whatever .env provides. On this platform .env is production,
        this suite covers ALL of tests/Feature, and 126 of those classes use
        RefreshDatabase, which runs migrate:fresh.

        Note also that boss888_test does not exist on this server. This config
        appears unused; it is hardened rather than deleted so nobody's workflow
        breaks, but it should be reviewed.
    -->
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="DB_CONNECTION" value="mysql" force="true"/>
        <env name="DB_DATABASE" value="boss888_test" force="true"/>
        <env name="CACHE_DRIVER" value="redis" force="true"/>
        <env name="QUEUE_CONNECTION" value="redis" force="true"/>
        <env name="SOCIAL_MOCK_MODE" value="true" force="true"/>
        <env name="BOSS888_DEBUG_ENABLED" value="true" force="true"/>
    </php>
</phpunit>

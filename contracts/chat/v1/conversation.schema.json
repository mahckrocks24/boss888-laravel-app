{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://levelupgrowth.io/contracts/chat/v1/conversation.schema.json",
  "title": "Chat Conversation v1",
  "description": "Canonical logical conversation. Clause C-01..C-06, C-19.",
  "type": "object",
  "required": ["id", "workspace_id", "channel", "status", "created_at", "updated_at"],
  "properties": {
    "id":              { "type": "string", "minLength": 1, "description": "C-01 stable across reload/session/device" },
    "workspace_id":    { "type": ["integer", "string"], "description": "C-02 server-derived; client MUST NOT supply" },
    "owner_user_id":   { "type": ["integer", "string", "null"], "description": "C-06 null permitted only if declared" },
    "agent_id":        { "type": ["string", "null"] },
    "channel":         { "type": "string", "enum": ["durable_agent", "durable_assistant", "durable_visitor", "durable_admin", "durable_room", "ephemeral_tool"], "description": "C-19" },
    "title":           { "type": ["string", "null"] },
    "status":          { "type": "string", "enum": ["open", "archived", "closed"] },
    "created_at":      { "type": "string", "format": "date-time" },
    "updated_at":      { "type": "string", "format": "date-time" },
    "last_message_at": { "type": ["string", "null"], "format": "date-time" },
    "identity_strategy": { "type": "string", "enum": ["row", "composite"], "description": "C-05 composite must be documented in the adapter" },
    "composite_key":   { "type": ["array", "null"], "items": { "type": "string" } },
    "metadata":        { "type": ["object", "null"] }
  },
  "additionalProperties": false
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://levelupgrowth.io/contracts/chat/v1/message.schema.json",
  "title": "Chat Message v1",
  "description": "Canonical logical message. Clause M-01..M-07.",
  "type": "object",
  "required": ["id", "conversation_id", "workspace_id", "correlation_id", "sender_type", "role", "type", "status", "content_type", "created_at"],
  "properties": {
    "id":                 { "type": "string", "minLength": 1 },
    "conversation_id":    { "type": "string", "minLength": 1 },
    "workspace_id":       { "type": ["integer", "string"] },
    "correlation_id":     { "type": "string", "minLength": 1, "description": "O-02 present on every message" },
    "idempotency_key":    { "type": ["string", "null"], "description": "I-01..I-03" },
    "client_message_id":  { "type": ["string", "null"] },
    "parent_message_id":  { "type": ["string", "null"], "description": "ack->final, tool_request->tool_result" },
    "sender_type":        { "type": "string", "enum": ["user", "agent", "system", "visitor"] },
    "sender_id":          { "type": ["integer", "string", "null"] },
    "agent_id":           { "type": ["string", "null"] },
    "role":               { "type": "string", "enum": ["user", "assistant", "system"] },
    "type":               { "type": "string", "enum": ["text", "markdown", "system_notice", "progress", "error", "tool_request", "tool_result", "approval_request", "attachment"], "description": "M-01 closed enum; extensions MUST use x_ prefix (M-02)" },
    "status":             { "type": "string", "enum": ["accepted", "acknowledged", "processing", "completed", "failed", "cancelled"], "description": "M-03 transition graph" },
    "content":            { "type": ["string", "null"], "description": "null permitted only for tool_request/approval_request" },
    "content_type":       { "type": "string", "enum": ["text", "markdown"] },
    "structured_content": { "type": ["object", "array", "null"] },
    "attachments":        { "type": ["array", "null"], "items": { "$ref": "attachment.schema.json" } },
    "tool_calls":         { "type": ["array", "null"], "items": { "$ref": "tool-call.schema.json" } },
    "approval":           { "oneOf": [{ "$ref": "approval.schema.json" }, { "type": "null" }] },
    "error":              { "oneOf": [{ "$ref": "error.schema.json" }, { "type": "null" }], "description": "F-05 non-null iff status=failed" },
    "usage":              { "oneOf": [{ "$ref": "usage.schema.json" }, { "type": "null" }] },
    "credits":            { "oneOf": [{ "$ref": "credits.schema.json" }, { "type": "null" }] },
    "provider":           { "type": ["string", "null"], "description": "F-02 REQUIRED when a provider was called" },
    "model":              { "type": ["string", "null"], "description": "F-02 REQUIRED when a provider was called" },
    "created_at":         { "type": "string", "format": "date-time" },
    "completed_at":       { "type": ["string", "null"], "format": "date-time", "description": "M-04 set on terminal status" },
    "read_at":            { "type": ["string", "null"], "format": "date-time" },
    "metadata":           { "type": ["object", "null"] }
  },
  "additionalProperties": false
}

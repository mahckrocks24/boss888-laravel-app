{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://levelupgrowth.io/contracts/chat/v1/approval.schema.json",
  "title": "Chat Approval v1",
  "description": "Clause AP-01..AP-04. GD-001: an assistant may REQUEST; governance DECIDES.",
  "type": "object",
  "required": ["id", "capability_key", "state", "requested_by"],
  "properties": {
    "id":             { "type": "string", "minLength": 1 },
    "capability_key": { "type": "string", "pattern": "^[a-z0-9_]+\\.[a-z0-9_]+$" },
    "state":          { "type": "string", "enum": ["pending", "approved", "denied", "expired", "cancelled"], "description": "AP-03 server-authoritative" },
    "effect":         { "type": ["string", "null"], "description": "AP-02 plain-language statement of what will happen" },
    "requested_by":   { "type": "object",
                        "required": ["type"],
                        "properties": {
                          "type": { "type": "string", "enum": ["agent", "user", "system"] },
                          "id":   { "type": ["string", "integer", "null"] }
                        },
                        "additionalProperties": false },
    "decided_by_user_id": { "type": ["integer", "string", "null"] },
    "decided_at":         { "type": ["string", "null"], "format": "date-time" },
    "expires_at":         { "type": ["string", "null"], "format": "date-time" },
    "executed":           { "type": "boolean", "default": false, "description": "AP-02 MUST be false while state=pending" }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if":   { "properties": { "state": { "const": "pending" } }, "required": ["state"] },
      "then": { "properties": { "executed": { "const": false } } }
    }
  ]
}
